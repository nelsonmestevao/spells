#!/usr/bin/env bash
# Show a colour in the terminal, as a background and as text, from its red,
# green and blue values.

set -Eeuo pipefail

PROGRAM=$(basename "${BASH_SOURCE[0]:-$0}")
VERSION=0.5.0

# Print a help section title in bold capitals. (tr, not ${*^^}: this runs on
# the bash 3.2 that macOS ships, too.)
function help_section() {
  printf '\033[1m%s\033[0m' "$(echo "$*" | tr '[:lower:]' '[:upper:]')"
}

function display_help() {
  cat <<EOF
  $(help_section Usage)
    ${PROGRAM} R G B [TEXT]
    ${PROGRAM} [options]

  $(help_section Options)
    -h, --help      Show this screen.
    -v, --version   Show version.
EOF
}

function print_color() {
  TEXT=${4:-" TEST "}

  echo -en "\e[48;2;$1;$2;$3m$TEXT\e[0m"
  echo -n ":  "
  echo "\e[48;2;$1;$2;$3m$TEXT\e[0m"
  echo -en "\e[38;2;$1;$2;$3m$TEXT\e[0m"
  echo -n ":  "
  echo "\e[38;2;$1;$2;$3m$TEXT\e[0m"
}

case ${1:-noption} in
  -h | --help)
    display_help
    exit 0
    ;;
  -v | --version)
    echo "${PROGRAM} v${VERSION}"
    exit 0
    ;;
esac

case $# in
  3 | 4)
    print_color "$@"
    ;;
  *)
    display_help >&2
    exit 1
    ;;
esac
