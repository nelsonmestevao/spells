#!/usr/bin/env nix-shell
#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p openssl
#! nix-shell -i bash

# Print a random secret in hex, such as a key for a web app's sessions.

set -Eeuo pipefail

PROGRAM=$(basename "${BASH_SOURCE[0]:-$0}")
VERSION=0.1.0

# shellcheck source=lib/spellbook.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/spellbook.sh"

function display_help() {
  cat <<HELP
  Print a random secret in hex, such as a key for a web app's sessions.

  $(help_section Usage)
    ${PROGRAM} [<bytes>]    A secret of <bytes> random bytes (32 unless you say).

  $(help_section Options)
    -h, --help      Show this screen.
    -v, --version   Show version.

  Each byte is two hex characters, so 32 bytes print 64.
HELP
}

case ${1:-32} in
-h | --help)
  display_help
  ;;
-v | --version)
  echo "${PROGRAM} v${VERSION}"
  ;;
*[!0-9]* | 0)
  display_help >&2
  exit 1
  ;;
*)
  openssl rand -hex "${1:-32}"
  ;;
esac
