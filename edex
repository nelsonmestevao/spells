#!/usr/bin/env bash
# Start eDEX-UI, the sci-fi terminal. Linux on an x86-64 computer only.
#
# The app is one 96 MB file, too big to keep in this repo. The first run
# downloads it from the project's releases on GitHub, checks that it is the
# right file, and keeps it in ~/.cache/edex. Later runs start at once.
#
# Needs from your system: curl, sha256sum and nix-shell.

set -euo pipefail

VERSION=2.2.8
URL=https://github.com/GitSquared/edex-ui/releases/download/v$VERSION/eDEX-UI-Linux-x86_64.AppImage
SHA256=c8f28cd721ca032ca0c1960b756ca3e64dc441a643c32eafbb79c673b402d681

# nix-shell passes this on to the command it runs.
export EDEX_APPIMAGE=${XDG_CACHE_HOME:-$HOME/.cache}/edex/eDEX-UI-$VERSION.AppImage

if [[ ! -f $EDEX_APPIMAGE ]]; then
  mkdir -p "$(dirname "$EDEX_APPIMAGE")"
  echo "Downloading eDEX-UI $VERSION (96 MB). This happens once."

  # The file gets its real name only after the check, so a download that was
  # cut short or is the wrong file is never started.
  download=$EDEX_APPIMAGE.download
  if ! curl --fail --location --progress-bar --output "$download" "$URL"; then
    rm -f "$download"
    echo "edex: could not download $URL" >&2
    exit 1
  fi
  if [[ $(sha256sum "$download" | cut -d ' ' -f 1) != "$SHA256" ]]; then
    rm -f "$download"
    echo "edex: the download is not the file this spell expects (wrong checksum)" >&2
    exit 1
  fi
  chmod +x "$download"
  mv "$download" "$EDEX_APPIMAGE"
fi

# The app runs inside appimage-run. libxshmfence is a library the app needs
# and appimage-run does not bring, so it is added to it here. Both come from
# the nixpkgs commit that the other spells use, and `spl bump` moves it too.
#
# The single quotes are on purpose: the shell that nix-shell starts reads them.
# shellcheck disable=SC2016
nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz \
  -p 'appimage-run.override { extraPkgs = pkgs: [ pkgs.libxshmfence ]; }' \
  --run 'appimage-run "$EDEX_APPIMAGE"'
