#!/usr/bin/env nix-shell
#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p perl
#! nix-shell -i sh

case ${1:---by-commit} in
  --by-line | --by-lines)
    git ls-files -z |
      xargs -0n1 git blame -w |
      perl -n -e '/^.*?\((.*?)\s+[\d]{4}/; print $1,"\n"' |
      sort -f | uniq -c | sort -n |
      tac | \nl | grep --color -z "Nelson Estevão"
    ;;
  --by-commit | --by-commits)
    # HEAD is needed: without a revision, shortlog reads the log from stdin
    # whenever stdin is not a terminal, and prints nothing.
    git shortlog -n -s --no-merges HEAD | \nl | grep --color -z "Nelson Estevão"
    ;;
esac
