#!/usr/bin/env nix-shell
#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p fzf
#! nix-shell -i bash

# Pick one or more commits from the log and copy their hashes to the clipboard.
#
# Needs from your system: git, and a clipboard tool (wl-copy, pbcopy or xsel).

# shellcheck source=lib/spellbook.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/spellbook.sh"

hashes=$(git log --color=always --oneline |
  fzf --multi --ansi --preview 'git show --color=always {+1}' |
  cut -d " " -f1)

# Nothing picked: leave the clipboard as it is.
[[ -n $hashes ]] || exit 1

if ! echo "$hashes" | to_clipboard; then
  echo "git-pick: found no clipboard tool (wl-copy, pbcopy or xsel)" >&2
  exit 1
fi
