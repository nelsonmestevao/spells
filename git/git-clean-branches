#!/usr/bin/env bash
set -euo pipefail

dry_run=false
remote=false
main_branch=

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run|-n) dry_run=true; shift ;;
    --remote|-r) remote=true; shift ;;
    --help|-h)
      echo "Usage: git clean-branches [--dry-run|-n] [--remote|-r] [branch]"
      echo ""
      echo "  --dry-run, -n   Preview deletions without executing them"
      echo "  --remote, -r    Also delete merged remote branches"
      echo "  branch          Main branch to compare against (default: the remote's"
      echo "                  default branch, or main, or master)"
      exit 0
      ;;
    -*) echo "Unknown option: $1" >&2; exit 1 ;;
    *) main_branch="$1"; shift ;;
  esac
done

current_branch=$(git branch --show-current 2>/dev/null || echo "")

# With no branch given, compare against the remote's default branch: what
# origin/HEAD points at. A repo that was not cloned has no origin/HEAD, so
# fall back to main, or to master.
if [[ -z $main_branch ]]; then
  main_branch=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)
  main_branch=${main_branch#origin/}
fi
if [[ -z $main_branch ]]; then
  if git show-ref --verify --quiet refs/heads/main; then
    main_branch=main
  else
    main_branch=master
  fi
fi

run() {
  if $dry_run; then
    echo "  (dry-run) $*"
  else
    "$@"
  fi
}

# The folder of the worktree that has a branch checked out, if there is one.
worktree_of() {
  git worktree list --porcelain | awk -v wanted="branch refs/heads/$1" '
    /^worktree / { folder = substr($0, 10) }
    $0 == wanted { print folder }'
}

# delete_branch <branch> <-d or -D> <merged or squash-merged>
#
# Delete a branch. git will not delete a branch that is checked out in a
# worktree, so that worktree goes first. A worktree with work that is not
# committed is left alone, and so is its branch.
delete_branch() {
  local branch=$1 flag=$2 kind=$3 worktree
  worktree=$(worktree_of "$branch")

  if [[ -d $worktree && -n $(git -C "$worktree" status --porcelain 2>/dev/null) ]]; then
    echo "Keeping $kind branch: $branch"
    echo "  its worktree has work that is not committed: $worktree"
    return 0
  fi

  echo "Deleting $kind branch: $branch"
  if [[ -n $worktree ]]; then
    echo "  and its worktree: $worktree"
    run git worktree remove "$worktree" || return 0
  fi
  run git branch "$flag" "$branch" || true
}

git fetch -p

# Forget worktrees whose folder was deleted by hand, so their branches are free.
run git worktree prune

# Delete branches detected as merged (fast-forward merges)
git for-each-ref --format '%(refname:short)' --merged "$main_branch" refs/heads/ | while read -r branch; do
  [[ "$branch" == "$main_branch" || "$branch" == "main" || "$branch" == "master" || "$branch" == "$current_branch" ]] && continue

  delete_branch "$branch" -d merged
done

# Delete branches that were squash-merged into the main branch
git for-each-ref --format '%(refname:short)' refs/heads/ | while read -r branch; do
  [[ "$branch" == "$main_branch" || "$branch" == "main" || "$branch" == "master" || "$branch" == "$current_branch" ]] && continue

  merge_base=$(git merge-base "origin/$main_branch" "$branch" 2>/dev/null) || continue
  tree=$(git rev-parse "$branch^{tree}" 2>/dev/null) || continue
  merge_commit=$(git commit-tree "$tree" -p "$merge_base" -m "test" 2>/dev/null) || continue

  if git cherry "origin/$main_branch" "$merge_commit" 2>/dev/null | grep -q '^-'; then
    delete_branch "$branch" -D squash-merged
  fi
done

# Delete remote branches that are merged
if $remote; then
  remote_merged=$(git branch -r --merged "origin/$main_branch" | grep -v "main\|master\|HEAD" | grep "origin" | sed 's/origin\///' || true)
  for branch in $remote_merged; do
    echo "Deleting remote branch: origin/$branch"
    run git push origin --delete "$branch"
  done
fi
