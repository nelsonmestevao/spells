#!/usr/bin/env nix-shell
#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p gum python313 python313Packages.xonsh python313Packages.docopt
#! nix-shell -i xonsh
"""
Sync all worktrees with the upstream principal branch of remote repository.

Usage:
  {program} [options]
  {program} (-h | --help)
  {program} --version

Options:
  -h --help              Show this screen.
  -v --version           Show version.
  -r --remote=<remote>   Remote repository [default: origin].
  -b --branch=<branch>   Branch to sync with.
                         Without it: the remote's default branch.

Needs from your system:
  git.
"""

import os
import re
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from spellbook import default_branch, failure, log_info, log_warn, parse_args, spin, step, success


def list_worktrees():
    """
    Parse `git worktree list` output to get (path, branch) tuples.
    Skips main/master/develop/dev and bare/detached worktrees.
    """
    output = $(git worktree list).splitlines()
    worktrees = []
    for line in output:
        # Format: /path/to/worktree  abc1234 [branch-name]
        match = re.match(r'^(\S+)\s+\S+\s+\[(.+)\]$', line)
        if not match:
            continue
        path, branch = match.group(1), match.group(2)
        if branch not in {"main", "master", "develop", "dev"}:
            worktrees.append((path, branch))
    return worktrees

def main(args):
    remote = args["--remote"]
    remote_branch = args["--branch"] or default_branch(remote)

    step(f"Fetching from {remote}", ["git", "fetch", remote])

    worktrees = list_worktrees()

    if not worktrees:
        log_warn("No worktrees found to sync")
        return

    log_info(f"Found {len(worktrees)} worktree{'s' if len(worktrees) != 1 else ''} ({', '.join(branch for _, branch in worktrees)}) to sync")

    original_dir = os.getcwd()

    for path, branch in worktrees:
        title = f"Syncing {branch}"
        os.chdir(path)

        if not spin(title, ["git", "rebase", f"{remote}/{remote_branch}"]):
            failure(f"Failed to rebase {branch} onto {remote}/{remote_branch}")
            step(f"Aborting rebase for {branch}", ["git", "rebase", "--abort"])
            continue

        if not spin(title, ["git", "push", "--force-with-lease", "--force-if-includes"]):
            failure(f"Failed to push {branch} onto {remote}/{remote_branch}")
            continue

        success(title)

    os.chdir(original_dir)


if __name__ == "__main__":
    main(parse_args(__doc__, __file__, version="0.1.2"))

