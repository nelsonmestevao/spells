#!/usr/bin/env nix-shell
#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p gum python313 python313Packages.xonsh python313Packages.docopt
#! nix-shell -i xonsh
"""
Select a git worktree interactively and print its path.

Usage:
  {program} [options]
  {program} (-h | --help)
  {program} --version

Options:
  -h --help              Show this screen.
  -v --version           Show version.

Needs from your system:
  git.
"""

from docopt import docopt, DocoptExit
from subprocess import CalledProcessError

import os
import re
import sys


RED="\033[31m"
RESET="\033[0m"


def error(msg):
    print(f"{msg} {RED}✗{RESET}", file=sys.stderr)
    sys.exit(1)


def main(args):
    listing = !(git worktree list)
    if listing.returncode != 0:
        print(listing.errors.strip(), file=sys.stderr)
        error("Could not list the worktrees")

    output = listing.out.strip()

    if not output:
        error("No worktrees found")

    lines = output.splitlines()

    if len(lines) < 2:
        error("Only one worktree (the main one)")

    # Build display lines: "branch  path"
    entries = []
    for line in lines:
        match = re.match(r'^(\S+)\s+\S+\s+\[(.+)\]$', line)
        if match:
            path, branch = match.group(1), match.group(2)
            entries.append(f"{branch}\t{path}")

    if not entries:
        error("No worktrees found")

    display = "\n".join(entries)
    try:
        selected = $(echo @(display) | gum filter --placeholder "Select worktree...").strip()
    except CalledProcessError as cancelled:
        sys.exit(cancelled.returncode)

    if not selected:
        sys.exit(1)

    # Extract the path (second column)
    path = selected.split("\t")[1]
    print(path)


if __name__ == "__main__":
    try:
        arguments = docopt(__doc__.format(program=__file__), version=f'{os.path.basename(__file__)} v0.1.3')
    except DocoptExit as wrong_usage:
        # xonsh takes docopt's exit for a crash and prints a traceback hint
        # above the usage. A plain SystemExit prints only the usage.
        sys.exit(wrong_usage.code)

    main(arguments)

