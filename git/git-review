#!/usr/bin/env nix-shell
#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p fzf
#! nix-shell -i bash

# Pick changed files from a list, with each file's diff as the preview.

git diff "$@" --name-only | fzf -m --ansi \
  --preview "git diff $* --color=always -- {-1}"
