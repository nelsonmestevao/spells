#!/usr/bin/env nix-shell
#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p curl
#! nix-shell -i sh

# Print a random git joke.

JOKES=https://raw.githubusercontent.com/EugeneKay/git-jokes/lulz/Jokes.txt

# With --fail, an error page from GitHub stops the spell here. Without it, a
# line of that page came out as the joke.
if ! jokes=$(curl --silent --fail --location "$JOKES"); then
  echo "git-joke: could not fetch the jokes from GitHub" >&2
  exit 1
fi

printf '%s\n' "$jokes" | awk 'BEGIN { srand() } int(rand() * NR) == 0 { x = $0 } END { print x }'
