#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p gum python313 python313Packages.xonsh python313Packages.docopt
#! nix-shell -i xonsh
"""
Sync all branches with the main branch of remote repository.

Usage:
  {program} [options]
  {program} (-h | --help)
  {program} --version

Options:
  -h --help              Show this screen.
  -v --version           Show version.
  -r --remote=<remote>   Remote repository [default: origin].
  -b --branch=<branch>   Branch to sync with.
                         Without it: the remote's default branch.

Needs from your system:
  git.
"""

import os
import re
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from spellbook import default_branch, failure, log_info, log_warn, parse_args, spin, step, success


def list_worktree_branches():
    """
    Parse `git worktree list` output to get branches checked out in worktrees.
    """
    output = $(git worktree list).splitlines()
    branches = set()
    for line in output:
        match = re.match(r'^(\S+)\s+\S+\s+\[(.+)\]$', line)
        if match:
            branches.add(match.group(2))
    return branches

def list_branches():
    """
    List local branches, excluding principal and worktree branches.
    """
    worktree_branches = list_worktree_branches()
    principal = {"main", "master", "develop", "dev"}
    branches = $(git for-each-ref '--format=%(refname:short)' refs/heads).splitlines()
    return [b for b in branches if b not in principal and b not in worktree_branches]

def main(args):
    remote = args["--remote"]
    remote_branch = args["--branch"] or default_branch(remote)

    step(f"Fetching from {remote}", ["git", "fetch", remote])

    step(f"Checking out {remote_branch}", ["git", "checkout", remote_branch])
    branches = list_branches()

    if not branches:
        log_warn("No branches found to sync")
        return

    log_info(f"Found {len(branches)} branch{'es' if len(branches) != 1 else ''} ({', '.join(branches)}) to sync")


    for branch in branches:
        title = f"Syncing {branch}"

        if not spin(title, ["git", "checkout", branch]):
            failure(f"Failed to checkout {branch}")
            continue

        if not spin(title, ["git", "rebase", f"{remote}/{remote_branch}"]):
            failure(f"Failed to rebase {branch} onto {remote}/{remote_branch}")
            step(f"Aborting rebase for {branch}", ["git", "rebase", "--abort"])
            continue

        if not spin(title, ["git", "push", "--force-with-lease", "--force-if-includes"]):
            failure(f"Failed to push {branch}")
            continue

        success(title)

if __name__ == "__main__":
    main(parse_args(__doc__, __file__, version="0.1.5"))

