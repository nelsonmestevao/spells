#!/usr/bin/env nix-shell
#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p gum python313 python313Packages.xonsh python313Packages.docopt
#! nix-shell -i xonsh
"""
Choose the desktop theme and applications' appearance based on that.

Usage:
  {program} [dark | light | status]
  {program} (-h | --help)
  {program} --version

Options:
  -h --help              Show this screen.
  -v --version           Show version.

Needs from your system:
  GNOME (gsettings) or macOS, and $DOTFILES set to your dotfiles folder.
"""

from docopt import docopt, DocoptExit
from subprocess import CalledProcessError

import os
import sys

$GREEN="\033[1;32m"
$RESET="\033[0m"

# $RAISE_SUBPROC_ERROR = True

DOTFILES     = os.path.expandvars("$DOTFILES")
GIT_CONFIG   = f"{DOTFILES}/home/programs/git/common.ini"
MACOS        = sys.platform == "darwin"

def pick_theme_interactively():
  try:
    return $(gum choose "dark" "light").strip()
  except CalledProcessError as cancelled:
    sys.exit(cancelled.returncode)

def gsettings_get_color_scheme():
  return $(gsettings get org.gnome.desktop.interface color-scheme).strip().lower()

def macos_is_dark():
  # The setting holds "Dark" in dark mode. In light mode it does not exist and
  # `defaults` fails. That is an answer, not an error, so `!()` and not `$()`.
  return !(defaults read -g AppleInterfaceStyle).out.strip() == "Dark"

def get_current_theme():
  if MACOS:
    return "dark" if macos_is_dark() else "light"

  match gsettings_get_color_scheme():
    case "'prefer-dark'":
        return "dark"
    case "'default'":
        return "light"
    case _:
        return "¯\\_(ツ)_/¯"

def set_theme_to(theme):
  cfg = {
        "dark": {
            "gsettings_scheme": "prefer-dark",
            "macos_dark_mode":  "true",
            "git_delta_light":  "false"
        },
        "light": {
            "gsettings_scheme": "default",
            "macos_dark_mode":  "false",
            "git_delta_light":  "true"
        },
    }[theme]

  sed -i @(f"s/light =.*/light = {cfg['git_delta_light']}/g") @(GIT_CONFIG)
  if MACOS:
    # The first time, macOS asks whether this terminal may control System Events.
    osascript -e @(f'tell application "System Events" to tell appearance preferences to set dark mode to {cfg["macos_dark_mode"]}')
  else:
    gsettings set org.gnome.desktop.interface color-scheme @(cfg["gsettings_scheme"])

  echo -e @(f"{theme} mode activated") "$GREEN✓$RESET"

def main(args):
    if args["dark"]:
        set_theme_to("dark")
    elif args["light"]:
        set_theme_to("light")
    elif args["status"]:
        print(get_current_theme())
    else:
        theme = pick_theme_interactively()
        set_theme_to(theme)

if __name__ == "__main__":
    try:
        arguments = docopt(__doc__.format(program=__file__), version=f'{os.path.basename(__file__)} v0.1.0')
    except DocoptExit as wrong_usage:
        # xonsh takes docopt's exit for a crash and prints a traceback hint
        # above the usage. A plain SystemExit prints only the usage.
        sys.exit(wrong_usage.code)

    main(arguments)

