#!/usr/bin/env bash
# Copy text to the clipboard.
#
# Usage:
#   copy file.txt          # copy file contents
#   copy < file.txt        # redirect file to clipboard
#   echo "hello" | copy    # pipe to clipboard
#
# Needs from your system: a clipboard tool (wl-copy, pbcopy or xsel).

# Copy what comes in to the clipboard, with the tool this system has.
to_clipboard() {
  if [[ -n ${WAYLAND_DISPLAY-} ]] && command -v wl-copy >/dev/null; then
    wl-copy
  elif command -v pbcopy >/dev/null; then
    pbcopy
  elif command -v xsel >/dev/null; then
    xsel --input --clipboard
  else
    echo "copy: found no clipboard tool (wl-copy, pbcopy or xsel)" >&2
    return 1
  fi
}

if [ $# -gt 0 ]; then
  cat "$@" | to_clipboard
else
  to_clipboard
fi
