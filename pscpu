"""
Show which apps use the most CPU right now.

All processes of one app are added up, so a browser with thirty helpers
shows as one line. CPU is a share of one core, so it can go over 100%.

Usage:
  {program} [-n <count>] [--processes]
  {program} (-h | --help)
  {program} --version

Options:
  -n <count>             How many lines to show [default: 10].
  -p --processes         One line per process, with its PID.
  -h --help              Show this screen.
  -v --version           Show version.

Needs from your system:
  ps.
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))
from spellbook import error, parse_args
from processes import print_top


def main(args):
    if not args["-n"].isdigit():
        error(f"-n takes a number, not '{args['-n']}'")

    print_top("cpu", int(args["-n"]), args["--processes"])


if __name__ == "__main__":
    main(parse_args(__doc__, __file__, version="0.2.0"))

