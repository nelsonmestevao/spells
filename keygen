#!/usr/bin/env nix-shell
#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p gum openssh
#! nix-shell -i bash

# Make a new SSH key and copy its public half to the clipboard.

set -Eeuo pipefail

PROGRAM=$(basename "${BASH_SOURCE[0]:-$0}")
VERSION=1.0.1

GREEN="\033[1;32m"
RESET="\033[0m"

# shellcheck source=lib/spellbook.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/spellbook.sh"

function display_help() {
  cat <<EOF
  Make a new SSH key and copy its public half to the clipboard.

  $(help_section Usage)
    ${PROGRAM}                            Ask for the type, comment and file.
    ${PROGRAM} (ed25519 | rsa) [<comment>]  Ask nothing but the passphrase.

  $(help_section Options)
    -h, --help      Show this screen.
    -v, --version   Show version.

  $(help_section Examples)
    ${PROGRAM}
    ${PROGRAM} ed25519
    ${PROGRAM} rsa email@example.com

  The key goes in ~/.ssh/id_<type>. The comment is <os>@<host> unless you
  give one, such as macos@laptop. If the file is there already, ${PROGRAM}
  asks before it replaces it.

  $(help_section "Needs from your system")
    A clipboard tool (wl-copy, pbcopy or xsel). Without one, ${PROGRAM}
    prints the public key instead.
EOF
}

# The comment the key gets when you give none: the system and the machine,
# such as macos@laptop or nixos@desktop.
function default_comment() {
  local os host
  if [[ $(uname -s) == Darwin ]]; then
    os=macos
  elif [[ -r /etc/os-release ]]; then
    os=$(sed -n 's/^ID=//p' /etc/os-release | tr -d '"')
  fi
  [[ -n ${os-} ]] || os=$(uname -s | tr '[:upper:]' '[:lower:]')
  host=$(uname -n)
  echo "$os@${host%%.*}"
}

# Show a path with ~ in place of the home folder.
function short() {
  echo "${1/#$HOME/\~}"
}

# generate_new_key <type> <comment> <file>
function generate_new_key() {
  local type=$1 comment=$2 file=$3

  if [[ -e $file || -e $file.pub ]]; then
    gum confirm --default=false "$(short "$file") is there already. Replace it?" || {
      local answer=$?
      echo "Kept $(short "$file") as it is."
      exit "$answer"
    }
  fi

  # shellcheck disable=SC2174  # only the folder that holds the key needs 700
  mkdir -p -m 700 "$(dirname "$file")"

  # ssh-keygen asks for the passphrase on the terminal, so it never shows up in
  # the process list. It keeps the old key until the new one is ready. The "y"
  # answers its own "Overwrite (y/n)?", which was already asked above, and
  # stdout holds nothing else with -q.
  #
  # With "y" as its input, ssh-keygen no longer sees a terminal there. On a
  # desktop it would then ask for the passphrase with $SSH_ASKPASS, a window
  # such as seahorse's. SSH_ASKPASS_REQUIRE=never keeps the question in the
  # terminal.
  case $type in
    ed25519) set -- -t ed25519 ;;
    rsa) set -- -t rsa -b 4096 ;;
  esac
  SSH_ASKPASS_REQUIRE=never ssh-keygen -q "$@" -C "$comment" -f "$file" <<<y >/dev/null

  echo -e "Saved $(short "$file") $GREEN✓$RESET"
  ssh-keygen -l -f "$file.pub"

  if to_clipboard <"$file.pub"; then
    echo -e "$(short "$file.pub") copied to the clipboard $GREEN✓$RESET"
  else
    echo "Found no clipboard tool (wl-copy, pbcopy or xsel). Here is the public key:"
    cat "$file.pub"
  fi
}

# Ask for the type, comment and file, with good answers filled in.
function ask_and_generate() {
  local type comment default_file file
  type=$(gum choose --header "Key type" "ed25519" "rsa (4096 bits, for old servers)")
  type=${type%% *}
  comment=$(gum input --header "Comment" --value "$(default_comment)")
  # shellcheck disable=SC2088  # shown with ~ on purpose, expanded below
  default_file="~/.ssh/id_$type"
  file=$(gum input --header "File" --value "$default_file")
  file=${file:-$default_file}
  generate_new_key "$type" "$comment" "${file/#\~/$HOME}"
}

case ${1-} in
  "")
    ask_and_generate
    ;;
  -h | --help)
    display_help
    ;;
  -v | --version)
    echo "${PROGRAM} v${VERSION}"
    ;;
  ed25519 | rsa)
    generate_new_key "$1" "${2:-$(default_comment)}" "$HOME/.ssh/id_$1"
    ;;
  *)
    display_help >&2
    exit 1
    ;;
esac
