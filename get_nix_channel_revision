#!/usr/bin/env nix-shell
#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p curl bash
#! nix-shell -i bash

# Print the git revision a NixOS channel points at.
#
#   get_nix_channel_revision 26.05
#   get_nix_channel_revision unstable

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: $(basename "$0") <release>   (for example 26.05 or unstable)" >&2
  exit 1
fi

CHANNEL="nixos-$1"

if ! REVISION=$(curl --silent --fail --location "https://channels.nixos.org/${CHANNEL}/git-revision"); then
  echo "Could not find the channel ${CHANNEL}" >&2
  exit 1
fi

echo "$REVISION"
