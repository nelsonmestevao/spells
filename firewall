#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p gum python313 python313Packages.xonsh python313Packages.docopt
#! nix-shell -i xonsh
"""
Turn the firewall on or off, so people on the same network can reach this computer.

Turning it off lets anyone on the network reach every open port. It turns
back on by itself when you reboot.

Usage:
  {program} [on | off | status]
  {program} (-h | --help)
  {program} --version

Options:
  -h --help              Show this screen.
  -v --version           Show version.

Needs from your system:
  systemctl and sudo, with a firewall service as on NixOS.
"""

import os
import socket
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))
from spellbook import ask, error, log_info, log_warn, parse_args, success


def systemctl_get_firewall_state():
    # is-active exits non-zero when the firewall is not running. That is an
    # answer, not a failure, so read the output without raising on it.
    return !(systemctl is-active firewall).out.strip()

def get_firewall_status():
    match systemctl_get_firewall_state():
        case "active":
            return "on"
        case "inactive":
            return "off"
        case other:
            return other

def local_ip():
    """This computer's address on the local network, or None when it has none."""
    # Connecting a UDP socket sends nothing. It only makes the system pick the
    # network interface, and so the address, that leads out of this computer.
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        try:
            s.connect(("192.0.2.1", 9))
        except OSError:
            return None
        return s.getsockname()[0]

def set_firewall(status):
    match status:
        case "on":
            action = "start"
        case "off":
            action = "stop"
        case _:
            error("no firewall status picked")

    if not ![sudo systemctl @(action) firewall]:
        error(f"could not turn the firewall {status}")

    success(f"firewall is {status}")

    if status == "off":
        ip = local_ip()
        if ip:
            log_info(f"people on this network can reach you at {ip}")
        log_warn("the firewall turns back on when you reboot")

def main(args):
    if args["on"]:
        set_firewall("on")
    elif args["off"]:
        set_firewall("off")
    elif args["status"]:
        print(get_firewall_status())
    else:
        set_firewall(ask("choose", "on", "off"))


if __name__ == "__main__":
    main(parse_args(__doc__, __file__, version="0.1.4"))

