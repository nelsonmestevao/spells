#!/usr/bin/env bash
# Stand-in for the macOS defaults command in tests. Like the real one, it
# prints "Dark" in dark mode and fails in light mode, where the setting does
# not exist.

if [[ "$*" != "read -g AppleInterfaceStyle" ]]; then
  echo "stand-in defaults: unknown command: $*" >&2
  exit 1
fi

if [[ $(cat "${STAND_IN_STATE:?}/macos-dark-mode" 2>/dev/null) == true ]]; then
  echo Dark
else
  echo "The domain/default pair of (kCFPreferencesAnyApplication, AppleInterfaceStyle) does not exist" >&2
  exit 1
fi
