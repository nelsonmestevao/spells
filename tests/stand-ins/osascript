#!/usr/bin/env bash
# Stand-in for osascript in tests. Understands the one script the spells
# send, from howLongUntilChristmas: display notification "<text>" with title
# "...". The text goes to the file the notify-send stand-in writes, so a test
# reads the same file on Linux and on macOS.

script="$*"

case $script in
  *'display notification "'*)
    text=${script#*display notification \"}
    echo "${text%%\"*}" >"${STAND_IN_STATE:?}/notification"
    ;;
  *)
    echo "stand-in osascript: unknown script: $*" >&2
    exit 1
    ;;
esac
