#!/usr/bin/env bash
# Stand-in for gsettings in tests. Keeps each key in its own file.

key_file=${STAND_IN_STATE:?}/gsettings.$2.$3

# Like the real one, print true and false bare and other values in quotes.
case $1 in
  get) cat "$key_file" 2>/dev/null || echo false ;;
  set)
    case $4 in
      true | false) echo "$4" >"$key_file" ;;
      *) echo "'$4'" >"$key_file" ;;
    esac
    ;;
  *)
    echo "stand-in gsettings: unknown command $1" >&2
    exit 1
    ;;
esac
