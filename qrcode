#!/usr/bin/env nix-shell
#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p qrencode
#! nix-shell -i bash

# Show a QR code for some text, usually a link, in the terminal.
#
#   qrcode https://example.com
#   qrcode https://example.com --large    # full-size blocks, easier to scan from afar

set -euo pipefail

TYPE=ANSIUTF8 # half-height blocks
TEXT=

for ARG in "$@"; do
  case "$ARG" in
    --large) TYPE=ANSI ;;
    *) TEXT=$ARG ;;
  esac
done

if [[ -z $TEXT ]]; then
  echo "Usage: $(basename "$0") <text> [--large]" >&2
  exit 1
fi

qrencode --type "$TYPE" "$TEXT"
printf '\n%s\n\n' "$TEXT"
