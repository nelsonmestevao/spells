#!/usr/bin/env nix-shell
#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p python313 python313Packages.xonsh python313Packages.docopt python313Packages.pymupdf4llm
#! nix-shell -i xonsh
"""
Show PDF files as Markdown.

Headings, lists and tables come from the layout of the text. A scanned PDF
has no text in it, only pictures of pages, so it comes out empty.

Usage:
  {program} <file>... [--pages=<pages>]
  {program} (-h | --help)
  {program} --version

Options:
  -p --pages=<pages>     Show only these pages, like 1-3,7 (1 is the first page).
  -h --help              Show this screen.
  -v --version           Show version.
"""

from docopt import docopt

import contextlib
import io
import os
import sys

import pymupdf

# pymupdf4llm prints a tip about an optional package when it loads. The tip
# is not part of any PDF, so it must stay out of the Markdown.
with contextlib.redirect_stdout(io.StringIO()):
    import pymupdf4llm

RED="\033[31m"
YELLOW="\033[33m"
RESET="\033[0m"


def error(msg):
    print(f"{msg} {RED}✗{RESET}", file=sys.stderr)
    sys.exit(1)

def log_warn(msg):
    print(f"{YELLOW}▲{RESET} {msg}", file=sys.stderr)


def open_pdf(path):
    if not os.path.isfile(path):
        error(f"'{path}' not found.")

    try:
        document = pymupdf.open(path)
    except Exception:
        error(f"Could not read '{path}'.")

    # pymupdf also opens e-books, images and plain text.
    if not document.is_pdf:
        error(f"'{path}' is not a PDF file.")
    if document.needs_pass:
        error(f"'{path}' is locked with a password.")

    return document

def page_numbers(wanted, path, page_count):
    """Turn "1-3,7" into [0, 1, 2, 6], the numbers pymupdf uses (0 is the first page)."""
    numbers = []
    for part in wanted.split(","):
        first, _, last = part.strip().partition("-")
        if not first.isdigit() or not (last or first).isdigit():
            error(f"'{wanted}' is not a list of pages, like 1-3,7.")

        first, last = int(first), int(last or first)
        if not 1 <= first <= last <= page_count:
            error(f"'{path}' has pages 1 to {page_count}. {part.strip()} is not in that range.")

        numbers.extend(range(first - 1, last))
    return numbers

def main(args):
    documents = [(path, open_pdf(path)) for path in args["<file>"]]

    for path, document in documents:
        pages = page_numbers(args["--pages"], path, document.page_count) if args["--pages"] else None
        markdown = pymupdf4llm.to_markdown(document, pages=pages)

        if markdown.strip():
            print(markdown, end="" if markdown.endswith("\n") else "\n")
        else:
            log_warn(f"No text in '{path}'. It may be a scanned PDF.")


if __name__ == "__main__":
    arguments = docopt(__doc__.format(program=__file__), version=f'{os.path.basename(__file__)} v0.1.0')

    try:
        main(arguments)
    except BrokenPipeError:
        # The reader stopped early, as `| head` does. Send what is left to
        # /dev/null, so the last flush does not fail too.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(1)

