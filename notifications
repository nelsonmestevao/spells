#!/usr/bin/env nix-shell
#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p gum python313 python313Packages.xonsh python313Packages.docopt
#! nix-shell -i xonsh
"""
Toggle desktop notification banners.

Usage:
  {program} [on | off | status]
  {program} (-h | --help)
  {program} --version

Options:
  -h --help              Show this screen.
  -v --version           Show version.

Needs from your system:
  gsettings (GNOME). macOS has no command for Do Not Disturb, so on a Mac
  this spell only says that it cannot switch them.
"""

from docopt import docopt, DocoptExit
from subprocess import CalledProcessError

import os
import sys


RED="\033[31m"
GREEN="\033[32m"
RESET="\033[0m"

MACOS = sys.platform == "darwin"


def success(msg):
    print(f"{msg} {GREEN}✓{RESET}")

def error(msg):
    print(f"{msg} {RED}✗{RESET}", file=sys.stderr)
    sys.exit(1)

def pick_status_interactively():
    try:
        return $(gum choose "on" "off").strip()
    except CalledProcessError as cancelled:
        sys.exit(cancelled.returncode)

def gsettings_get_show_banners():
    return $(gsettings get org.gnome.desktop.notifications show-banners).strip().lower()

def get_notifications_status():
    match gsettings_get_show_banners():
        case "true":
            return "on"
        case "false":
            return "off"
        case other:
            return other

def set_notifications(status):
    match status:
        case "on":
            gsettings set org.gnome.desktop.notifications show-banners true
        case "off":
            gsettings set org.gnome.desktop.notifications show-banners false

    success(f"notifications are {status}")

def main(args):
    if MACOS:
        # macOS has no command for Do Not Disturb. The only supported way is
        # a shortcut made by hand in the Shortcuts app.
        error("notifications cannot be switched on macOS")

    if args["on"]:
        set_notifications("on")
    elif args["off"]:
        set_notifications("off")
    elif args["status"]:
        print(get_notifications_status())
    else:
        set_notifications(pick_status_interactively())


if __name__ == "__main__":
    try:
        arguments = docopt(__doc__.format(program=__file__), version=f'{os.path.basename(__file__)} v0.2.0')
    except DocoptExit as wrong_usage:
        # xonsh takes docopt's exit for a crash and prints a traceback hint
        # above the usage. A plain SystemExit prints only the usage.
        sys.exit(wrong_usage.code)

    main(arguments)

