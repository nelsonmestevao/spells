#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p gum python313 python313Packages.xonsh python313Packages.docopt
#! nix-shell -i xonsh
"""
Manage spells.

Usage:
  {program} new [<name>] [--description=<desc>]
  {program} edit [<name>]
  {program} (-h | --help)
  {program} --version

Commands:
  new       Create a new spell from a template.
  edit      Open an existing spell in the editor.

Options:
  -h --help                    Show this screen.
  -v --version                 Show version.
  -d --description=<desc>      Short description of the spell.

Needs from your system:
  $EDITOR set to your editor.
"""

from docopt import docopt
from subprocess import CalledProcessError

import os
import sys


RED="\033[31m"
GREEN="\033[32m"
RESET="\033[0m"


def success(msg):
    print(f"{msg} {GREEN}✓{RESET}")

def error(msg):
    print(f"{msg} {RED}✗{RESET}", file=sys.stderr)
    sys.exit(1)


SPELLS = os.path.expanduser("~/.spells")

TEMPLATE = '''#!/usr/bin/env nix-shell
#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p gum python313 python313Packages.xonsh python313Packages.docopt
#! nix-shell -i xonsh
"""
{description}

Usage:
  {{program}} [options]
  {{program}} (-h | --help)
  {{program}} --version

Options:
  -h --help              Show this screen.
  -v --version           Show version.
"""

from docopt import docopt

import os
import sys

# Keep the colours and helpers you use. Delete the rest.
RED="\\033[31m"
GREEN="\\033[32m"
YELLOW="\\033[33m"
BLUE="\\033[34m"
RESET="\\033[0m"


def success(msg):
    print(f"{{msg}} {{GREEN}}✓{{RESET}}")

def error(msg):
    print(f"{{msg}} {{RED}}✗{{RESET}}", file=sys.stderr)
    sys.exit(1)

def log_warn(msg):
    print(f"{{YELLOW}}▲{{RESET}} {{msg}}", file=sys.stderr)

def log_info(msg):
    print(f"{{BLUE}}◆{{RESET}} {{msg}}")


