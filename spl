#!/usr/bin/env nix-shell
#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p gum python313 python313Packages.xonsh python313Packages.docopt
#! nix-shell -i xonsh
"""
Manage spells.

Usage:
  {program} new [<name>] [--description=<desc>]
  {program} edit [<name>]
  {program} list
  {program} bump [<revision>]
  {program} (-h | --help)
  {program} --version

Commands:
  new       Create a new spell from a template.
  edit      Open an existing spell in the editor.
  list      Show every spell with the line that says what it does.
  bump      Move every spell to the newest nixpkgs-unstable commit,
            or to <revision> (a full commit hash).

Options:
  -h --help                    Show this screen.
  -v --version                 Show version.
  -d --description=<desc>      Short description of the spell.

Needs from your system:
  git, and $EDITOR set to your editor.
"""

import os
import re
import sys
import urllib.request

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))
from spellbook import ask, error, log_info, parse_args, success


# The folder this file is in. Every command works on the spells next to it.
SPELLS = os.path.dirname(os.path.realpath(__file__))

# Each spell names one nixpkgs commit in its header, like this.
NIXPKGS = "https://github.com/NixOS/nixpkgs/archive/{revision}.tar.gz"
PINNED_NIXPKGS = re.compile(r"https://github\.com/NixOS/nixpkgs/archive/[0-9a-f]{40}\.tar\.gz")
NIXPKGS_CHANNEL = "nixpkgs-unstable"

TEMPLATE = '''#!/usr/bin/env nix-shell
#! nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/680275f0bb6afce84fbac3e75fc47c5f2272400b.tar.gz
#! nix-shell -p gum python313 python313Packages.xonsh python313Packages.docopt
#! nix-shell -i xonsh
"""
{description}

Usage:
  {{program}} [options]
  {{program}} (-h | --help)
  {{program}} --version

Options:
  -h --help              Show this screen.
  -v --version           Show version.
"""

import os
import sys

# The helpers the spells share are in lib/spellbook.xsh. Import the ones you use.
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))
from spellbook import error, log_info, log_warn, parse_args, success


def main(args):
    pass


if __name__ == "__main__":
    main(parse_args(__doc__, __file__, version="0.1.0"))

# vim: ft=python
'''

def pick_spell_name():
    return ask("input", "--placeholder", "Spell name")

def pick_spell_interactively():
    spells = [f for f in os.listdir(SPELLS) if os.path.isfile(os.path.join(SPELLS, f)) and not f.startswith('.')]
    spells.sort()
    return ask("filter", *spells)

def new_spell(name, description):
    if not name:
        name = pick_spell_name()

    if not name:
        error("No name provided.")

    path = os.path.join(SPELLS, name)

    if os.path.exists(path):
        error(f"Spell '{name}' already exists.")

    if not description:
        description = ask("input", "--placeholder", "Short description of the spell")

    with open(path, 'w') as f:
        f.write(TEMPLATE.format(description=description or "TODO: describe this spell."))

    os.chmod(path, 0o755)
    success(f"Created spell '{name}'")

    $EDITOR @(path)

def edit_spell(name):
    if not name:
        name = pick_spell_interactively()

    if not name:
        error("No spell selected.")

    path = os.path.join(SPELLS, name)

    if not os.path.isfile(path):
        error(f"Spell '{name}' not found.")

    $EDITOR @(path)

def spells():
    """(name as you type it, path) of each spell here and in git/."""
    found = []
    for folder, is_git in ((SPELLS, False), (os.path.join(SPELLS, "git"), True)):
        if not os.path.isdir(folder):
            continue
        for name in sorted(os.listdir(folder)):
            path = os.path.join(folder, name)
            if name.startswith(".") or not os.path.isfile(path) or not os.access(path, os.X_OK):
                continue
            # git-browse is run as "git browse".
            found.append((name.replace("git-", "git ", 1) if is_git else name, path))
    return found

def describe(path):
    """The line that says what a spell does.

    That is the first comment under its header, or the first line of its
    docstring. "" when the spell has neither, None when the file is not text.
    """
    try:
        with open(path, encoding="utf-8") as f:
            start = f.read(4000)
    except (UnicodeDecodeError, OSError):
        return None

    for line in start.splitlines()[1:]:
        line = line.strip()
        if line in ("", "#") or line.startswith(("#! nix-shell", "# -*-")):
            continue
        if line.startswith('"""'):
            docstring = start.split('"""')[1]
            return next((text.strip() for text in docstring.splitlines() if text.strip()), "")
        if line.startswith("# "):
            return line[2:].strip()
        break
    return ""

def list_spells():
    described = [(name, describe(path)) for name, path in spells()]
    described = [(name, text) for name, text in described if text is not None]
    width = max(len(name) for name, _ in described)
    for name, text in described:
        print(f"{name:<{width}}  {text}".rstrip())

def newest_revision():
    """The commit the nixpkgs-unstable channel points at right now."""
    url = f"https://channels.nixos.org/{NIXPKGS_CHANNEL}/git-revision"
    try:
        with urllib.request.urlopen(url) as response:
            return response.read().decode().strip()
    except OSError as problem:
        error(f"Could not ask {url} for the newest commit: {problem}")

def files_with_a_pin():
    """Every file in the spells folder that names a pinned nixpkgs, new ones included."""
    found = !(git -C @(SPELLS) grep --files-with-matches --untracked -I "github.com/NixOS/nixpkgs/archive/")
    return found.out.splitlines()

def bump(revision):
    revision = revision or newest_revision()

    if not re.fullmatch("[0-9a-f]{40}", revision):
        error(f"'{revision}' is not a full commit hash (40 letters and digits).")

    changed = []
    for name in files_with_a_pin():
        path = os.path.join(SPELLS, name)
        with open(path) as f:
            before = f.read()
        after = PINNED_NIXPKGS.sub(NIXPKGS.format(revision=revision), before)
        if after != before:
            with open(path, "w") as f:
                f.write(after)
            changed.append(name)

    if not changed:
        log_info(f"Every spell already uses nixpkgs {revision}")
        return

    success(f"{len(changed)} files now use nixpkgs {revision}")
    log_info("The first run of each spell downloads its new packages.")
    log_info("Run tests/run to check that the spells still work.")

def main(args):
    if args["new"]:
        new_spell(args["<name>"], args["--description"])
    elif args["edit"]:
        edit_spell(args["<name>"])
    elif args["list"]:
        list_spells()
    elif args["bump"]:
        bump(args["<revision>"])

if __name__ == "__main__":
    main(parse_args(__doc__, __file__, version="0.6.0"))

