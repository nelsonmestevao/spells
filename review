#!/usr/bin/env bash

# Usage:
#   review                      # commits on this branch since it left main/master,
#                               # or uncommitted changes when there are none
#   review <target> [base]      # passed straight to difit (e.g. `review feature main`)
#   review .                    # uncommitted changes

# 1. Determine the difit arguments
if [ $# -eq 0 ]; then
    BASE=$(git merge-base HEAD main 2>/dev/null || git merge-base HEAD master 2>/dev/null)
    HEAD_REV=$(git rev-parse HEAD 2>/dev/null)

    if [ -z "$BASE" ] || [ "$BASE" = "$HEAD_REV" ]; then
        # No base, or nothing committed past it: review uncommitted changes
        set -- .
        LABEL="Local Changes"
    else
        # difit wants `<target> [compare-with]`, not a `base..target` range
        set -- HEAD "$BASE"
        LABEL="$BASE..HEAD"
    fi
else
    LABEL="$*"
fi

echo "--- Reviewing: $LABEL ---"

# 2. Run via nix-shell, escaping each argument separately for the subshell
SAFE_ARGS=$(printf '%q ' "$@")

nix-shell -p nodejs --run "npx difit $SAFE_ARGS"
